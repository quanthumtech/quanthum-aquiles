APP_NAME="__APP_NAME__"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Pilar: AI Driven Development — QaiOnlineService (app/Services/AI)
QAI_ONLINE_URL=
QAI_ONLINE_KEY=
QAI_ONLINE_MODEL=gpt-4o-mini
QAI_ONLINE_TIMEOUT=240

# Pilar: Security First / Login por LDAP (opt-in) — só usado se AUTH_PROVIDER=ldap
LDAP_CONNECTION=default
LDAP_HOST=
LDAP_USERNAME=
LDAP_PASSWORD=
LDAP_PORT=389
LDAP_BASE_DN=
LDAP_TIMEOUT=5
LDAP_TLS=false
LDAP_STARTTLS=false
LDAP_SASL=false
LDAP_LOGGING=true
LDAP_CACHE=false

# eloquent (padrão, funciona sem servidor LDAP) ou ldap (SSO real — ver README)
AUTH_PROVIDER=eloquent

# SSO Quanthum (OIDC, perfil quanthum-oidc-profile 1.0) — desligado por padrão.
# O client (id/secret/redirect) é cadastrado no quanthum-sso pela Quanthum
# Services; o segredo vai só aqui, nunca em config/*.php nem no git.
# Redirect URI: <APP_URL>/quanthum-sso/callback (exata, HTTPS, sem curinga).
QUANTHUM_SSO_ENABLED=false
QUANTHUM_SSO_AUTO_PROVISION=false
QUANTHUM_SSO_ISSUER=
QUANTHUM_SSO_CLIENT_ID=
QUANTHUM_SSO_CLIENT_SECRET=
QUANTHUM_SSO_REDIRECT_URI=
QUANTHUM_SSO_POST_LOGOUT_REDIRECT_URI=

# Licença do produto junto ao servidor Quanthum Licenses — desligada por padrão.
QUANTHUM_LICENSE_SERVER_URL=
QUANTHUM_PRODUCT_KEY=
QUANTHUM_LICENSE_KEY=
QUANTHUM_LICENSE_PUBLIC_KEY=
QUANTHUM_LICENSE_ENFORCE=false

# Cliente do Quanthum Checkout (só HTTP para o servidor de checkout; sem provedor
# de pagamento neste app). Webhook de saída: POST /api/webhooks/quanthum-checkout.
CHECKOUT_BASE_URL=
CHECKOUT_CLIENT_TOKEN=
CHECKOUT_WEBHOOK_SECRET=
CHECKOUT_WEBHOOK_SECRET_PREVIOUS=
